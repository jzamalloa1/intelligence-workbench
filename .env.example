# ─────────────────────────────────────────────────────────────────────────────
# Copy to `.env` and fill in. `.env` is gitignored — never commit real values.
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# ── Which provider the agent runs on ─────────────────────────────────────────
# "anthropic" or "openai". Switches model tiers AND the prompt variant.
LLM_PROVIDER=anthropic

# Optional: force a single tier for every role (lead/worker/cheap).
# Useful for cost experiments. Leave unset to use the per-role tiering.
# LLM_TIER_OVERRIDE=

# ── Model provider keys ──────────────────────────────────────────────────────
# Only the one matching LLM_PROVIDER is strictly required.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ── Tools ────────────────────────────────────────────────────────────────────
# Web research. https://tavily.com
TAVILY_API_KEY=

# ── LangSmith ────────────────────────────────────────────────────────────────
# Required for `mda deploy`. NOT required for `mda dev`.
# Tracing is optional but strongly recommended — it's how you see subagent spans.
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true

# ── Frontend (web/.env.local) ────────────────────────────────────────────────
# Where the agent is served. `mda dev` defaults to port 2024.
LANGGRAPH_URL=http://127.0.0.1:2024

# OPTIONAL. Controls which CopilotKit runner is used:
#   set   → IntelligenceAgentRunner  (durable threads, threads drawer, Inspector;
#                                     conversation history stored by CopilotKit)
#   unset → InMemoryAgentRunner      (local only; history lost on server restart.
#                                     NB: the documented SqliteAgentRunner does
#                                     not exist in @copilotkit/runtime 1.69.3)
# INTELLIGENCE_API_KEY=

# The CopilotKit runtime sends anonymous telemetry by default.
# https://docs.copilotkit.ai/telemetry
COPILOTKIT_TELEMETRY_DISABLED=true

# OPTIONAL. CopilotKit's Inspector shows the live AG-UI event stream — useful for
# learning the protocol. Off by default: it mounts a floating launcher over the
# page and adds a "View in Inspector" button to every assistant message.
# NEXT_PUBLIC_ENABLE_INSPECTOR=true
